(* ::Package:: *)

(* Reduce a rational expression modulo the ideal generated by the Gram-type
   relation(s) `gens` (default: the 6-point Gram G6), i.e. give its value on
   the variety where those relations vanish. Works via Groebner-basis
   polynomial division, so it generalizes to several simultaneous
   constraints (e.g. G6 together with a 5-point Gram) by passing more
   generators in `gens`. *)

G6 = Get[FileNameJoin[{DirectoryName[$InputFileName], "SixPointGram.txt"}]];

(* Elimination order: put the invariants that only show up in Gram-type
   relations (not in your typical denominators) first, so they get reduced
   away; adjust/extend if your expressions use other variables. *)
GramVarsOrder = {mt2, s16, s345, s45, s123, s234, s56, s12, s23, s34};

(* Method 1: pure polynomial division by G6. Cheap, and when it works it
   expresses the answer in the ORIGINAL kinematic invariants (mt2, s16, ...),
   which reads nicer. But it only removes monomials via the single pivot
   variable order above, so for expressions with higher degree in several
   of those invariants at once (e.g. a cubed numerator) it can leave a
   "correct but un-cancelled" mess even though a real simplification exists. *)
SimplifyOnVariety[expr_, gens_List : {}, vars_List : GramVarsOrder] :=
 Module[{num, den, gb, rem, generators},
  generators = If[gens === {}, {G6}, gens];
  {num, den} = {Numerator[#], Denominator[#]} &@Together[expr];
  gb = GroebnerBasis[generators, vars];
  rem = PolynomialReduce[num, gb, vars][[2]];
  Cancel[rem/den]
  ]

(* Method 2: substitute the explicit rational parametrization of the G6=0
   variety (KinematicRulesBackWards from 4DBasis/Parametrization.m, which
   solves mt2,s16,s345,s45 in terms of the 9 free paravars {s12,s23,s34,
   s123,s234,s56,c1,c2,c3} such that G6 vanishes identically). This is the
   canonical/guaranteed-full reduction: since it removes all redundancy up
   front, Factor/Together is free to find every cancellation, at the cost of
   expressing the answer in paravars instead of mt2/s16/etc. Use this one
   whenever Method 1 leaves something that still looks uncancelled. *)
Get[FileNameJoin[{DirectoryName[$InputFileName], "..", "4DBasis",
    "Parametrization.m"}]];
SimplifyOnVarietyParam[expr_] := Factor[Together[expr /. KinematicRulesBackWards]]
