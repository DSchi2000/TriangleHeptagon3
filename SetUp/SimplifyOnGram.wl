(* ::Package:: *)

(* Reduce a rational expression modulo the ideal generated by the Gram-type
   relation(s) `gens` (default: the 6-point Gram G6), i.e. give its value on
   the variety where those relations vanish. Works via Groebner-basis
   polynomial division, so it generalizes to several simultaneous
   constraints (e.g. G6 together with a 5-point Gram) by passing more
   generators in `gens`. *)

G6 = Get[FileNameJoin[{DirectoryName[$InputFileName], "SixPointGram.txt"}]];

(* Elimination order: put the invariants that only show up in Gram-type
   relations (not in your typical denominators) first, so they get reduced
   away; adjust/extend if your expressions use other variables. *)
GramVarsOrder = {mt2, s16, s345, s45, s123, s234, s56, s12, s23, s34};

(* Method 1: pure polynomial division by G6. Cheap, and when it works it
   expresses the answer in the ORIGINAL kinematic invariants (mt2, s16, ...),
   which reads nicer. But it only removes monomials via the single pivot
   variable order above, so for expressions with higher degree in several
   of those invariants at once (e.g. a cubed numerator) it can leave a
   "correct but un-cancelled" mess even though a real simplification exists. *)
SimplifyOnVariety[expr_, gens_List : {}, vars_List : GramVarsOrder] :=
 Module[{num, den, gb, rem, generators},
  generators = If[gens === {}, {G6}, gens];
  {num, den} = {Numerator[#], Denominator[#]} &@Together[expr];
  gb = GroebnerBasis[generators, vars];
  rem = PolynomialReduce[num, gb, vars][[2]];
  Cancel[rem/den]
  ]

(* Method 2: substitute the explicit rational parametrization of the G6=0
   variety (KinematicRulesBackWards from 4DBasis/Parametrization.m, which
   solves mt2,s16,s345,s45 in terms of the 9 free paravars {s12,s23,s34,
   s123,s234,s56,c1,c2,c3} such that G6 vanishes identically). This is the
   canonical/guaranteed-full reduction: since it removes all redundancy up
   front, Factor/Together is free to find every cancellation, at the cost of
   expressing the answer in paravars instead of mt2/s16/etc. Use this one
   whenever Method 1 leaves something that still looks uncancelled. *)
Get[FileNameJoin[{DirectoryName[$InputFileName], "..", "4DBasis",
    "Parametrization.m"}]];
SimplifyOnVarietyParam[expr_] := Factor[Together[expr /. KinematicRulesBackWards]]

(* Method 3: factor-by-factor reduction in a single variable (default: s16,
   which is degree <= 2 in G6 for every letter seen so far). FactorList the
   numerator and denominator separately; for every irreducible factor (of
   EITHER one, unlike Method 1) whose degree in `var` is >= its degree in the
   constraint, polynomial-divide by the constraint and re-factor the
   remainder; then let Cancel merge whatever duplicate factors that exposes.
   This is what actually finds a simplification like a big denominator
   factor collapsing to a product of two much smaller known letters, while
   (unlike Method 2) keeping the answer in the ORIGINAL kinematic invariants
   and (unlike Method 1) not leaving an uncancelled mess when the numerator
   or denominator is a high power of something. Validated on NewArg9393.txt:
   reproduces N^3/(s34*A*M*C) in ~0.1s, matching the hand derivation and
   agreeing with the original expression numerically at actual roots of
   G6=0. Use this as the first thing to try on a new NewArg-*.txt; fall back
   to Method 2 if it leaves visibly uncancelled high-degree factors (that
   means the relevant redundant variable isn't `var`, or the degree
   condition above doesn't isolate all the reducible pieces). *)
SimplifyOnVarietyFactored[expr_, gens_List : {}, var_ : s16] := Module[
  {constraint, degc, num, den, reduceOne, numFL, denFL, newNum, newDen},
  constraint = If[gens === {}, G6, First[gens]];
  degc = Exponent[constraint, var];

  reduceOne[{base_, exp_}] := Module[{d, rem},
    d = Exponent[base, var];
    If[d >= degc && degc > 0,
      rem = PolynomialQuotientRemainder[base, constraint, var][[2]];
      Map[{#[[1]], #[[2]]*exp} &, FactorList[rem]]
      ,
      {{base, exp}}
    ]
  ];

  {num, den} = {Numerator[#], Denominator[#]} &@Together[expr];
  numFL = Flatten[reduceOne /@ FactorList[num], 1];
  denFL = Flatten[reduceOne /@ FactorList[den], 1];
  newNum = Times @@ (Power @@@ numFL);
  newDen = Times @@ (Power @@@ denFL);
  Cancel[newNum/newDen]
  ]

(* Same as above, but returns an Association with before/after LeafCounts and
   the list of (original factor -> reduced factor list) replacements that
   were actually performed, for logging when batching over many letters. *)
SimplifyOnVarietyFactoredReport[expr_, gens_List : {}, var_ : s16] := Module[
  {constraint, degc, num, den, reduceOne, log, numFL, denFL, newNum, newDen,
   result},
  constraint = If[gens === {}, G6, First[gens]];
  degc = Exponent[constraint, var];
  log = {};

  reduceOne[{base_, exp_}] := Module[{d, rem, flist},
    d = Exponent[base, var];
    If[d >= degc && degc > 0,
      rem = PolynomialQuotientRemainder[base, constraint, var][[2]];
      flist = FactorList[rem];
      AppendTo[log, base -> flist[[All, 1]]];
      Map[{#[[1]], #[[2]]*exp} &, flist]
      ,
      {{base, exp}}
    ]
  ];

  {num, den} = {Numerator[#], Denominator[#]} &@Together[expr];
  numFL = Flatten[reduceOne /@ FactorList[num], 1];
  denFL = Flatten[reduceOne /@ FactorList[den], 1];
  newNum = Times @@ (Power @@@ numFL);
  newDen = Times @@ (Power @@@ denFL);
  result = Cancel[newNum/newDen];

  <|
    "Simplified" -> result,
    "LeafCountBefore" -> LeafCount[expr],
    "LeafCountAfter" -> LeafCount[result],
    "ReducedFactors" -> log
  |>
  ]

(* Method 3b: like Method 3, but doesn't commit to a single fixed pivot
   variable. IMPORTANT: the thing to minimize is the LeafCount of the WHOLE
   reassembled expression, NOT the LeafCount of the individual remainder --
   an earlier version of this filtered candidates by "is this factor's own
   remainder smaller than the factor it replaces", which looks like the
   right local check but isn't: on TestForClaude.txt the s16-pivot
   remainder of the big numerator factor is itself LARGER than the factor
   it replaces (5096 vs 4473 leaves), yet substituting it is exactly what
   lets the whole expression's denominator cancel away, collapsing 4630
   leaves down to 163 -- a reduction a "shrink this factor first" filter
   rejects outright, even though the plain fixed-s16-pivot Method 3 finds it
   trivially (it never checks the local factor size at all). So instead,
   for every irreducible factor (numerator and denominator alike) and every
   candidate variable in `vars` that (a) clears the degree gate
   (deg_v(base) >= deg_v(constraint) > 0) and (b) gives a genuinely
   POLYNOMIAL quotient (a non-polynomial quotient just reintroduces a
   spurious denominator), this actually substitutes that one factor's
   remainder into the full expression, re-cancels, and measures the
   resulting TOTAL LeafCount. Among every (factor, variable) trial across
   the whole expression it greedily accepts whichever single substitution
   shrinks the total the most, then re-factors (since a reduction can
   expose a new factor whose degree in some other variable only now clears
   the gate -- e.g. the 118-leaf sub-factor that appears after reducing
   TestForClaude.txt's old content via s234) and repeats, stopping when no
   remaining substitution helps or after maxSteps. This is more expensive
   (each trial re-Cancels the whole expression) but actually optimizes what
   you care about instead of a local proxy for it. *)
GlobalBestStep[current_, constraint_, vars_List] := Module[
  {num, den, numFL, denFL, curLC, bestTrial, bestLC, bestInfo},
  {num, den} = {Numerator[current], Denominator[current]};
  numFL = FactorList[num];
  denFL = FactorList[den];
  curLC = LeafCount[current];
  bestTrial = Missing["none"];
  bestLC = curLC;
  bestInfo = Missing["none"];

  Do[
   Module[{base, exp, restNum},
    {base, exp} = numFL[[i]];
    restNum = Times @@ (Power @@@ Delete[numFL, i]);
    Do[
     Module[{d, degc, qr, Q, R, trial, trialLC},
      d = Exponent[base, v];
      degc = Exponent[constraint, v];
      If[d >= degc && degc > 0,
       qr = PolynomialQuotientRemainder[base, constraint, v];
       Q = Together[qr[[1]]];
       If[Denominator[Q] === 1,
        R = Together[qr[[2]]];
        trial = Cancel[(restNum*R^exp)/den];
        trialLC = LeafCount[trial];
        If[trialLC < bestLC,
         bestLC = trialLC; bestTrial = trial;
         bestInfo = <|"Which" -> "Numerator", "Index" -> i, "Var" -> v|>;
         ]
        ]
       ]
      ],
     {v, vars}
     ]
    ],
   {i, Length[numFL]}
   ];

  Do[
   Module[{base, exp, restDen},
    {base, exp} = denFL[[i]];
    restDen = Times @@ (Power @@@ Delete[denFL, i]);
    Do[
     Module[{d, degc, qr, Q, R, trial, trialLC},
      d = Exponent[base, v];
      degc = Exponent[constraint, v];
      If[d >= degc && degc > 0,
       qr = PolynomialQuotientRemainder[base, constraint, v];
       Q = Together[qr[[1]]];
       If[Denominator[Q] === 1,
        R = Together[qr[[2]]];
        trial = Cancel[num/(restDen*R^exp)];
        trialLC = LeafCount[trial];
        If[trialLC < bestLC,
         bestLC = trialLC; bestTrial = trial;
         bestInfo = <|"Which" -> "Denominator", "Index" -> i, "Var" -> v|>;
         ]
        ]
       ]
      ],
     {v, vars}
     ]
    ],
   {i, Length[denFL]}
   ];

  {bestTrial, bestLC, bestInfo}
  ]

SimplifyOnVarietyFactoredBest[expr_, gens_List : {}, vars_List : GramVarsOrder,
   maxSteps_Integer : 30] := Module[
  {constraint, current, step, result},
  constraint = If[gens === {}, G6, First[gens]];
  current = Together[expr];
  For[step = 1, step <= maxSteps, step++,
   result = GlobalBestStep[current, constraint, vars];
   If[MissingQ[result[[1]]], Break[]];
   current = result[[1]];
   ];
  current
  ]

(* Same as above, but returns an Association with before/after LeafCounts and
   a log of every accepted step (which factor, which pivot variable, and the
   resulting total LeafCount), for inspecting/batching. *)
SimplifyOnVarietyFactoredBestReport[expr_, gens_List : {}, vars_List : GramVarsOrder,
   maxSteps_Integer : 30] := Module[
  {constraint, current, step, result, log},
  constraint = If[gens === {}, G6, First[gens]];
  current = Together[expr];
  log = {};
  For[step = 1, step <= maxSteps, step++,
   result = GlobalBestStep[current, constraint, vars];
   If[MissingQ[result[[1]]], Break[]];
   AppendTo[log,
    <|"Step" -> step, "LeafCountBefore" -> LeafCount[current],
      "LeafCountAfter" -> result[[2]], "Choice" -> result[[3]]|>];
   current = result[[1]];
   ];
  <|
   "Simplified" -> current,
   "LeafCountBefore" -> LeafCount[expr],
   "LeafCountAfter" -> LeafCount[current],
   "Steps" -> log
   |>
  ]

(* Batch-process a list of NewArg-style files: for each, Get the expression,
   run SimplifyOnVarietyFactoredReport, Export "<name>-G6zero.txt" next to
   it, and print a one-line progress report. Works identically whether
   called from a notebook cell (after evaluating/Getting this file) or from
   the command-line wrapper RunSimplifyOnGram.wls -- this is the one place
   the actual batch logic lives, so both stay in sync. Returns the list of
   output paths written. *)
SimplifyFilesOnGram[files_List, gens_List : {}, var_ : s16] :=
 Table[
  Module[{expr, rep, outPath},
   If[!FileExistsQ[file],
    Print["SKIP (not found): ", file];
    Continue[]
    ];
   expr = Get[file];
   rep = SimplifyOnVarietyFactoredReport[expr, gens, var];
   outPath = StringReplace[file, ".txt" ~~ EndOfString -> "-G6zero.txt"];
   If[outPath === file, outPath = file <> "-G6zero.txt"];
   Export[outPath, rep["Simplified"]];
   Print[file, ":  ", rep["LeafCountBefore"], " -> ", rep["LeafCountAfter"],
    " leaves  (", Length[rep["ReducedFactors"]], " factor(s) reduced)  ==> ",
    outPath];
   outPath
   ],
  {file, files}
  ]

(* Same as SimplifyFilesOnGram, but uses SimplifyOnVarietyFactoredBestReport
   (tries every pivot variable per factor, keeps the smallest polynomial
   reduction, iterates) instead of a single fixed pivot. Slower per file, but
   finds reductions the fixed-s16 pivot misses entirely -- e.g. an expression
   whose numerator is only degree 1 in s16 but degree 2 in other invariants. *)
SimplifyFilesOnGramBest[files_List, gens_List : {}, vars_List : GramVarsOrder,
   maxSteps_Integer : 30] :=
 Table[
  Module[{expr, rep, outPath},
   If[!FileExistsQ[file],
    Print["SKIP (not found): ", file];
    Continue[]
    ];
   expr = Get[file];
   rep = SimplifyOnVarietyFactoredBestReport[expr, gens, vars, maxSteps];
   outPath = StringReplace[file, ".txt" ~~ EndOfString -> "-G6zero.txt"];
   If[outPath === file, outPath = file <> "-G6zero.txt"];
   Export[outPath, rep["Simplified"]];
   Print[file, ":  ", rep["LeafCountBefore"], " -> ", rep["LeafCountAfter"],
    " leaves  (", Length[rep["Steps"]], " step(s))  ==> ", outPath];
   outPath
   ],
  {file, files}
  ]
